# Azure OpenAI Configuration (optional - AI features use smart fallbacks when not set)
AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
AZURE_OPENAI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# App Settings
SECRET_KEY=change-this-to-a-random-secret-key-in-production
DATABASE_URL=sqlite:///./panchaayat.db

# Social media API keys (optional — enable live ingestion from platforms)
# X (Twitter) API v2 — https://developer.twitter.com/
TWITTER_BEARER_TOKEN=

# Reddit API — https://www.reddit.com/prefs/apps (create "script" or "web app")
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=Panchaayat/1.0 by your_reddit_username

# Meta Graph API — https://developers.facebook.com/ (Page + Instagram Business)
META_ACCESS_TOKEN=
META_PAGE_ID=
META_INSTAGRAM_BUSINESS_ID=

# LinkedIn Marketing / Community API — https://www.linkedin.com/developers/
LINKEDIN_ACCESS_TOKEN=

# SerpAPI — optional fallback to search X, LinkedIn, Facebook, Instagram via Google
# https://serpapi.com/
SERPAPI_KEY=

# Set to false in production when API keys are configured
SOCIAL_MENTIONS_INCLUDE_DEMO=true

# Vercel: set SECRET_KEY in Project Settings → Environment Variables.
# DATABASE_URL is optional on Vercel (defaults to /tmp/panchaayat.db).
